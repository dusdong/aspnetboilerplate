<Project>
  <PropertyGroup>
    <PackageId>Du.$(PackageId)</PackageId>
    <PackageVersion>$(DuR3CandidatePackageVersion)</PackageVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/dusdong/aspnetboilerplate.git</RepositoryUrl>
    <RepositoryCommit>$(DuR3CandidateCommit)</RepositoryCommit>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(DuR3CandidateSourceProof)" Pack="true" PackagePath="/du-r3-candidate-source.json"
          Condition="'$(DuR3CandidateSourceProof)' != ''" />
  </ItemGroup>
  <Target Name="ValidateDuR3CandidatePackInputs" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(DuR3CandidatePackageVersion)' == ''" Text="候选打包需要 DuR3CandidatePackageVersion。" />
    <Error Condition="'$(DuR3CandidateSourceProof)' == '' Or !Exists('$(DuR3CandidateSourceProof)')"
           Text="候选打包需要有效的源码来源记录，请使用 nupkg/pack-r3-module-zero-candidates.sh。" />
  </Target>
</Project>
