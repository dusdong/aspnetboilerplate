<Project>
  <PropertyGroup>
    <PackageId>Du.$(PackageId)</PackageId>
    <PackageVersion>$(DuCoreCandidatePackageVersion)</PackageVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/dusdong/aspnetboilerplate.git</RepositoryUrl>
    <RepositoryCommit>$(DuCoreCandidateCommit)</RepositoryCommit>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(DuCoreCandidateSourceProof)" Pack="true" PackagePath="/du-core-candidate-source.json"
          Condition="'$(DuCoreCandidateSourceProof)' != ''" />
  </ItemGroup>
  <Target Name="ValidateDuCoreCandidatePackInputs" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(DuCoreCandidatePackageVersion)' == ''" Text="候选打包需要 DuCoreCandidatePackageVersion。" />
    <Error Condition="'$(DuCoreCandidateSourceProof)' == '' Or !Exists('$(DuCoreCandidateSourceProof)')"
           Text="候选打包需要有效的源码来源记录，请使用 nupkg/pack-r2-candidates.sh。" />
  </Target>
</Project>
